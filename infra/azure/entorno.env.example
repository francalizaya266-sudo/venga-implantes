# Configuración del despliegue, SIN secretos. Cópialo a infra/azure/entorno.env (está en .gitignore) y complétalo.
# Lo lee infra/desplegar.sh.

# Región permitida por la suscripción de estudiante: az policy assignment list --disable-scope-strict-match --query "[].parameters.listOfAllowedLocations.value" -o tsv
# Chile Central es la más cercana a Perú (tiene la serie B v2, no la B1s).
REGION=chilecentral
# La sede va en otra región permitida: cada región tiene su propia cuota de 6 vCPU y producción ya usa las de Chile.
# De las regiones permitidas, solo North Central US ofrece además la serie B v2 a las suscripciones de estudiante.
REGION_SEDE=northcentralus

# Nombre o id de cada suscripción (az account list -o table).
SUB_PROD="Azure for Students"
SUB_SEDE="Azure for Students"

RG_PROD=rg-vega-prod
RG_SEDE=rg-vega-clinica

# Dominio de la web (el .TECH del Student Pack). El DNS de la sede lo lleva al proxy por la VPN.
DOMINIO=vegaimplant.tech

# Correo del equipo para las alertas y el presupuesto.
ALERT_EMAIL=

# Tu IP pública (búscala en ifconfig.me): podrás entrar por SSH a los firewalls desde tu PC además de Cloud Shell.
# El script le suma la IP de Cloud Shell al momento de correrlo.
MI_IP=

# Repositorio de GitHub que puede publicar en vm-app sin claves (dueño/nombre).
GITHUB_REPO=francalizaya266-sudo/venga-implantes

# Apagar vm-proxy y vm-app cada noche (HHmm, hora de Lima). Vacío = sin apagado automático. Chile Central y México
# Central no tienen el apagado automático de Azure (DevTestLab): ahí se apaga con "desplegar.sh apagar".
AUTO_SHUTDOWN=

# SSH directo a vm-app y vm-proxy mientras no existe la VPN. Ponlo en false al terminar la fase 4 y vuelve a
# correr "desplegar.sh produccion vms".
SETUP_SSH=true
