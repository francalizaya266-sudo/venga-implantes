# Configuración del despliegue, SIN secretos. Cópialo a infra/azure/entorno.env (está en .gitignore) y complétalo.
# Lo lee infra/desplegar.sh.

# Región que permita tu suscripción de estudiante (az account list-locations -o table).
REGION=brazilsouth

# Nombre o id de cada suscripción (az account list -o table).
SUB_PROD="Azure for Students"
SUB_SEDE="Azure for Students"

RG_PROD=rg-vega-prod
RG_SEDE=rg-vega-clinica

# Correo del equipo para las alertas y el presupuesto.
ALERT_EMAIL=

# Tu IP pública, la del navegador con el que abres el panel de OPNsense (búscala en "cuál es mi IP").
# El script le suma la IP de Cloud Shell al momento de correrlo.
MI_IP=

# Repositorio de GitHub que puede publicar en vm-app sin claves (dueño/nombre).
GITHUB_REPO=francalizaya266-sudo/venga-implantes

# Apagar vm-proxy y vm-app cada noche (HHmm, hora de Lima). Vacío = siempre encendidas.
AUTO_SHUTDOWN=2300

# SSH directo a vm-app y vm-proxy mientras no existe la VPN. Ponlo en false al terminar la fase 4 y vuelve a
# correr "desplegar.sh produccion vms".
SETUP_SSH=true
