# Configuración de producción SIN secretos. deploy-app.sh la junta con los secretos de Key Vault y escribe el .env.
# Se copia a vm-app como /etc/vega/app.env y se completan los valores marcados con <...>.
# Los secretos NO van aquí: van en Key Vault con estos nombres (ver infra/README.md, fase 2):
#   app-key, db-password, db-password-despliegue, db-password-respaldo,
#   mail-password, whatsapp-cloud-token, dni-lookup-token, sentry-dsn

APP_NAME="Clínica Vega Implant"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://<dominio>
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# El proxy de la DMZ: Laravel ve la IP real del paciente y sabe que la conexión es HTTPS.
TRUSTED_PROXIES=10.20.3.4

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=<salida mysqlHost>
DB_PORT=3306
DB_DATABASE=consultorio
DB_USERNAME=consultorio_app
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<usuario SMTP de Brevo>
MAIL_FROM_ADDRESS=<correo verificado>
MAIL_FROM_NAME="${APP_NAME}"

CLINIC_WHATSAPP=+51918874568
REMINDERS_AT=09:00
FLAG_UNCONFIRMED_AT=16:00
WHATSAPP_DRIVER=click_to_chat
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

BACKUPS_KEEP=14

SENTRY_SEND_DEFAULT_PII=false
