#!/usr/sbin/nft -f
# Firewall de producción (vm-fw en vnet-vega). Es la única entrada desde internet.
# eth0 = WAN (10.20.0.4, con la IP pública) · eth1 = LAN (10.20.1.4, siguiente salto de la DMZ y la app).
# Cambiar una regla: edita este archivo, haz un pull request y aplica con "bash infra/desplegar.sh reglas".

flush ruleset

define WAN = "eth0"
define LAN = "eth1"
define PROXY = 10.20.3.4
define APP = 10.20.4.4
define DMZ = 10.20.3.0/24
define APPNET = 10.20.4.0/24
define SEDE = 10.10.0.0/16
# El firewall de la sede (WAN y LAN): hace de jump host para administrar producción por la VPN.
define SEDE_MGMT = 10.10.0.0/23
define WAZUH = 10.10.50.10
# Wazuh también recibe la copia horaria de la base de datos.
define RESPALDO = 10.10.50.10

table inet filtro {
    chain entrada {
        type filter hook input priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
        iif "lo" accept
        icmp type echo-request limit rate 5/second accept
        # IKE y NAT-T de la VPN con la sede.
        udp dport { 500, 4500 } accept
        # SSH del propio firewall: el NSG solo deja llegar a las IP de administración; por la VPN, el jump host.
        tcp dport 2200 accept
        ip saddr $SEDE_MGMT tcp dport 22 accept
        log prefix "fw-entrada-bloqueo " level info drop
    }

    chain reenvio {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop

        # Internet -> proxy de la DMZ (después del NAT de destino).
        iifname $WAN ip daddr $PROXY tcp dport { 80, 443 } accept

        # SSH de instalación, antes de la VPN (el NSG lo limita a las IP de administración).
        iifname $WAN ip daddr { $PROXY, $APP } tcp dport 22 accept

        # El proxy es el único que llega a la aplicación.
        ip saddr $PROXY ip daddr $APP tcp dport 80 accept

        # Desde la sede, por la VPN: el personal al proxy, el jump host por SSH.
        ip saddr $SEDE ip daddr $PROXY tcp dport { 80, 443 } accept
        ip saddr $SEDE_MGMT ip daddr { $PROXY, $APP } tcp dport 22 accept

        # De la aplicación a la sede: logs al SIEM y copia horaria al respaldo.
        ip saddr $APP ip daddr $WAZUH tcp dport { 1514, 1515 } accept
        ip saddr $APP ip daddr $RESPALDO tcp dport 22 accept

        # Salida a internet de la DMZ y la aplicación: actualizaciones, Key Vault, Blob, WhatsApp, correo (587).
        iifname $LAN oifname $WAN ip saddr { $DMZ, $APPNET } ip daddr != $SEDE tcp dport { 80, 443, 587 } accept
        iifname $LAN oifname $WAN ip saddr { $DMZ, $APPNET } udp dport 123 accept

        # Si el proxy cae, no llega a nada más.
        log prefix "fw-reenvio-bloqueo " level info drop
    }
}

table ip nat {
    chain destino {
        type nat hook prerouting priority dstnat;
        iifname $WAN tcp dport { 80, 443 } dnat to $PROXY
        iifname $WAN tcp dport 2222 dnat to $APP:22
        iifname $WAN tcp dport 2223 dnat to $PROXY:22
    }

    chain origen {
        type nat hook postrouting priority srcnat;
        # Lo que va a la sede viaja por la VPN con su IP original.
        oifname $WAN ip daddr != $SEDE masquerade
    }
}
