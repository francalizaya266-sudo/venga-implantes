#!/usr/sbin/nft -f
# Firewall de la sede de la clínica (vm-fw en vnet-clinica): separa las subredes (equivalen a las VLAN del diseño)
# y une la sede con producción por la VPN.
# eth0 = WAN (10.10.0.4, con la IP pública) · eth1 = LAN (10.10.1.4, siguiente salto de todas las subredes).
# Cambiar una regla: edita este archivo, haz un pull request y aplica con "bash infra/desplegar.sh reglas".

flush ruleset

define WAN = "eth0"
define LAN = "eth1"
define INTERNAS = 10.10.0.0/16
define MGMT = 10.10.10.0/24
define PERSONAL = 10.10.30.0/24
define SERVIDORES = 10.10.50.0/24
define DMZ = 10.10.60.0/24
define PROD = 10.20.0.0/16
define PROXY_PROD = 10.20.3.4
define APP_PROD = 10.20.4.4
define WAZUH = 10.10.50.10
define RESPALDO = 10.10.50.20
define HONEYPOT = 10.10.60.10
define JUMP = 10.10.10.20

table inet filtro {
    chain entrada {
        type filter hook input priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
        iif "lo" accept
        icmp type echo-request limit rate 5/second accept
        udp dport { 500, 4500 } accept
        # SSH del propio firewall (el NSG lo limita a las IP de administración) y desde el jump host.
        tcp dport 2200 accept
        ip saddr $MGMT tcp dport 22 accept
        # DNS interno (Unbound) para las subredes de la sede.
        ip saddr $INTERNAS udp dport 53 accept
        ip saddr $INTERNAS tcp dport 53 accept
        log prefix "fw-entrada-bloqueo " level info drop
    }

    chain reenvio {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop

        # Desde internet (después del NAT de destino): tu SSH al jump host y los señuelos del honeypot.
        iifname $WAN ip daddr $JUMP tcp dport 22 accept
        iifname $WAN ip daddr $HONEYPOT tcp dport { 22, 3306 } accept

        # La DMZ solo puede enviar sus logs al SIEM; nada más hacia adentro.
        ip saddr $DMZ ip daddr $WAZUH tcp dport { 1514, 1515 } accept
        ip saddr $DMZ ip daddr { $INTERNAS, $PROD } log prefix "fw-dmz-bloqueo " level info drop

        # Recepción: el panel de producción por la VPN; no administra servidores.
        ip saddr $PERSONAL ip daddr $PROXY_PROD tcp dport { 80, 443 } accept
        ip saddr $PERSONAL ip daddr { $MGMT, $SERVIDORES } log prefix "fw-personal-bloqueo " level info drop

        # El jump host administra todo, en la sede y en producción.
        ip saddr $MGMT accept

        # Logs al SIEM desde los servidores de la sede.
        ip saddr $SERVIDORES ip daddr $WAZUH tcp dport { 1514, 1515 } accept

        # Desde producción, por la VPN: logs y syslog al SIEM, y la copia horaria al respaldo.
        ip saddr $PROD ip daddr $WAZUH tcp dport { 1514, 1515 } accept
        ip saddr $PROD ip daddr $WAZUH udp dport 514 accept
        ip saddr $APP_PROD ip daddr $RESPALDO tcp dport 22 accept

        # Salida a internet para actualizaciones (la DMZ también: el honeypot instala OpenCanary, pero hacia
        # adentro ya quedó bloqueada más arriba).
        iifname $LAN oifname $WAN ip saddr $INTERNAS ip daddr != $PROD tcp dport { 80, 443 } accept
        iifname $LAN oifname $WAN ip saddr $INTERNAS udp dport 123 accept

        log prefix "fw-reenvio-bloqueo " level info drop
    }
}

table ip nat {
    chain destino {
        type nat hook prerouting priority dstnat;
        iifname $WAN tcp dport 2222 dnat to $JUMP:22
        iifname $WAN tcp dport { 22, 3306 } dnat to $HONEYPOT
    }

    chain origen {
        type nat hook postrouting priority srcnat;
        oifname $WAN ip daddr != $PROD masquerade
    }
}
